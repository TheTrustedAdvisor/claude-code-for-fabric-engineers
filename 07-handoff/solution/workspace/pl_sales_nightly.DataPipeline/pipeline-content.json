        "typeProperties": {
          "items": { "value": "@activity('Lookup tables').output.value", "type": "Expression" },
          "isSequential": false,
          "batchCount": 8,
          "activities": [
            { "name": "Copy table", "type": "Copy", "typeProperties": { "source": { "type": "SqlServerSource" }, "sink": { "type": "LakehouseTableSink" } } }
          ]
        }
      }
    ]
  }
}
