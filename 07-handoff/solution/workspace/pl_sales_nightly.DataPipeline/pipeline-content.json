{
  "properties": {
    "activities": [
      {
        "name": "Lookup tables",
        "type": "Lookup",
        "typeProperties": {
          "source": { "type": "SqlServerSource", "sqlReaderQuery": "SELECT table_schema, table_name FROM etl.ingest_tables WHERE pipeline = 'sales'" },
          "firstRowOnly": false
        }
      },
      {
        "name": "ForEach table",
        "type": "ForEach",
