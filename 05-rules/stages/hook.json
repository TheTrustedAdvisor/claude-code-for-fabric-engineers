{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "allow": [
      "Bash(./deploy.sh *)",
      "Bash(python3 deploy.py *)"
    ],
    "deny": [
      "Bash(./deploy.sh prod*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-prod.py"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
